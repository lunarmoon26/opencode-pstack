  "repository": { "type": "git", "url": "git+https://github.com/lunarmoon26/opencode-pstack.git" },
  "homepage": "https://github.com/lunarmoon26/opencode-pstack#readme",
  "type": "module",
  "exports": { ".": "./plugin/pstack.ts" },
  "files": ["index.ts", "plugin", "dist", "LICENSE", "THIRD_PARTY.md", "upstream.json"],
  "scripts": {
    "build": "bun scripts/build.ts",
